{
    "manifest_version": 3,
    "name": "Spiral Tube",
    "version": "2.3.0",
    "key": "",
    "default_locale": "en",
    "description": "Transform YouTube with 50+ features: glassmorphism themes, 600% equaliser with custom EQ, cinema filters, SponsorBlock integration, focus & zen modes, custom speed controller, ambient mode, screenshot tool, subscription groups, watch history analytics, and a redesigned glassmorphic popup UI.",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "alarms",
        "contextMenus",
        "notifications",
        "identity",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "<all_urls>",
        "*://www.youtube.com/*"
    ],
    "icons": {
        "16": "src/assets/icons/icon-16.png",
        "32": "src/assets/icons/icon-32.png",
        "48": "src/assets/icons/icon-48.png",
        "128": "src/assets/icons/icon-128.png"
    },
    "oauth2": {
        "client_id": "441579938178-esrd1qbfdk71c19spnpokgrvr531i0u8.apps.googleusercontent.com",
        "scopes": [
            "https://www.googleapis.com/auth/drive.appdata",
            "email",
            "profile"
        ]
    },
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "src/assets/icons/icon-16.png",
            "32": "src/assets/icons/icon-32.png",
            "48": "src/assets/icons/icon-48.png",
            "128": "src/assets/icons/icon-128.png"
        }
    },
    "commands": {
        "popup-focused": {
            "suggested_key": {
                "default": "Alt+Shift+P"
            },
            "description": "Popup the focused or hovered video"
        },
        "toggle-mini": {
            "suggested_key": {
                "default": "Alt+Shift+M",
                "mac": "Alt+Shift+M"
            },
            "description": "Toggle miniplayer for the current popup"
        },
        "close-popup": {
            "suggested_key": {
                "default": "Alt+Shift+X",
                "mac": "Alt+Shift+X"
            },
            "description": "Close the current popup"
        },
        "open-search": {
            "suggested_key": {
                "default": "Alt+S"
            },
            "description": "Open floating YouTube search"
        }
    },
    "background": {
        "service_worker": "dist/service-worker.js",
        "type": "module"
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "src/declarative_net_request/ruleset_1.json"
            }
        ]
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    },
    "options_page": "src/options/options.html",
    "content_scripts": [
        {
            "matches": [
                "*://www.youtube.com/*"
            ],
            "css": [
                "dist/style.css"
            ],
            "run_at": "document_end",
            "all_frames": true,
            "js": [
                "dist/content.js"
            ]
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "*://*.youtube.com/*",
                "*://youtube.com/*"
            ],
            "run_at": "document_idle",
            "all_frames": true,
            "js": [
                "dist/global-bar-external.js"
            ]
        },
        {
            "matches": [
                "*://www.youtube.com/*"
            ],
            "js": [
                "dist/page-bridge.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "*://*.youtube.com/*",
                "*://youtube.com/*",
                "*://youtu.be/*"
            ],
            "css": [
                "src/content/features/popup-player/popup-player.css"
            ],
            "js": [
                "src/content/features/popup-player/engine.js",
                "src/content/features/popup-player/custom-ui.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/assets/*",
                "src/assets/icons/*",
                "src/assets/fonts/*",
                "src/inject/*", "src/content/features/popup-player/popup-player-embed.html",
                "src/popup/*",
                "dist/*-bundle.css"
            ],
            "matches": [
                "*://www.youtube.com/*",
                "<all_urls>"
            ]
        }
    ]
}
