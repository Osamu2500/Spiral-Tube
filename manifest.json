{
    "manifest_version": 3,
    "name": "Spiral Tube",
    "version": "2.3.0",
    "default_locale": "en",
    "description": "Transform YouTube with 50+ features: glassmorphism themes, 600% volume booster with custom EQ, cinema filters, SponsorBlock integration, focus & zen modes, custom speed controller, ambient mode, screenshot tool, subscription groups, watch history analytics, and a redesigned glassmorphic popup UI.",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "alarms",
        "contextMenus",
        "notifications"
    ],
    "host_permissions": [
        "<all_urls>",
        "*://www.youtube.com/*",
        "*://returnyoutubedislikeapi.com/*",
        "*://sponsor.ajay.app/*"
    ],
    "icons": {
        "16": "src/assets/icon-16.png",
        "32": "src/assets/icon-32.png",
        "48": "src/assets/icon-48.png",
        "128": "src/assets/icon-128.png"
    },
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "16": "src/assets/icon-16.png",
            "32": "src/assets/icon-32.png",
            "48": "src/assets/icon-48.png",
            "128": "src/assets/icon-128.png"
        }
    },
    "background": {
        "service_worker": "dist/service-worker.js",
        "type": "module"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    },
    "options_page": "src/options/options.html",
    "content_scripts": [
        {
            "matches": [
                "*://www.youtube.com/*"
            ],
            "css": [
                "dist/style.css"
            ],
            "run_at": "document_end",
            "all_frames": false,
            "js": [
                "dist/content.js"
            ]
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "exclude_matches": [
                "*://*.youtube.com/*",
                "*://youtube.com/*"
            ],
            "run_at": "document_idle",
            "all_frames": true,
            "js": [
                "dist/global-bar-external.js"
            ]
        },
        {
            "matches": [
                "*://www.youtube.com/*"
            ],
            "js": [
                "dist/page-bridge.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "src/assets/*",
                "src/assets/fonts/*",
                "src/assets/cursors/*",
                "src/inject/*",
                "src/popup/*",
                "dist/themes/**/*.css",
                "dist/ui-styles/**/*.css",
                "dist/card-styles/*.css",
                "src/content/core-framework/card-styles/*.css",
                "src/content/features/**/*.css",
                "src/content/features/**/*.js"
            ],
            "matches": [
                "*://www.youtube.com/*",
                "<all_urls>"
            ]
        }
    ]
}