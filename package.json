{
  "name": "spiral-tube",
  "version": "2.3.0",
  "description": "Spiral Tube — YouTube Power Extension",
  "license": "MIT",
  "scripts": {
    "build:css": "node scripts/build/build-themes.js",
    "create-theme": "node scripts/build/create-theme.js",
    "build": "npm run build:css && vite build && vite build --config vite.config.sw.js && vite build --config vite.config.external.js",
    "watch": "vite build --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "terser": "^5.51.2",
    "typescript": "^5.5.4",
    "vite": "^5.0.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "animejs": "^3.2.2"
  }
}
